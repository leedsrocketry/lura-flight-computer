{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy" // rust-analyzer.check.command (default: "check")
        },
        // Explicitly register both Cargo projects.
        "linkedProjects": [
          "Cargo.toml",
          "onboard/Cargo.toml"
        ],

        // Don't check all targets, including tests.
        "cargo": {
          "allTargets": false
        }
      }
    }
  }
}
